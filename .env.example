# Copy to .env on the backend host. Never commit the real .env.
# The MacBook launcher generates .env.local (see docs/macbook-testing.md).

# Required: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

FIREBASE_PROJECT_ID=finder-owl

# Use ONE of these credential options:
# 1) Path to the Admin SDK service account JSON
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
# 2) Or the JSON itself as a single-line string (used instead of the path when set)
# SERVICE_ACCOUNT_JSON=

# App Check rollout: off | monitor | enforce
# Start at "monitor" to log failures without breaking clients, then switch to "enforce".
APP_CHECK_MODE=monitor

# Extra allowed CORS origins, comma-separated (exact scheme+host matches only)
ALLOWED_ORIGINS=

# Number of reverse-proxy hops in front of this app (1 behind nginx/ngrok)
TRUST_PROXY_HOPS=1

PORT=3000

# ---------------------------------------------------------------------------
# Data backend: firestore | local
# "local" stores everything in a JSON file on this machine and makes ZERO
# Firebase calls. It is refused when NODE_ENV=production unless
# ALLOW_LOCAL_BACKEND=1. This is the MacBook testing mode.
# ---------------------------------------------------------------------------
DATA_BACKEND=firestore
LOCAL_DB_FILE=.local-data/owl-db.json

# ---------------------------------------------------------------------------
# Auth: firebase | local
# "local" accepts one email+password pair and issues backend JWTs, so the
# MacBook can run with no Firebase Auth project at all. Refused in production
# and whenever App Check is enabled.
# ---------------------------------------------------------------------------
AUTH_MODE=firebase
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Free-tier quota guard (server/lib/quota-policy.js + quota-guard.js)
# The Firebase copy stops serving at 80% of the free allowance and tells the
# website to use the fallback URLs instead.
# ---------------------------------------------------------------------------
QUOTA_ACTION=stop            # stop | monitor | off
QUOTA_THRESHOLD=0.8          # fraction of the free limit that triggers the stop
QUOTA_SOURCE=auto            # auto | local | monitoring
QUOTA_FALLBACK_URLS=         # comma-separated, e.g. https://owl-mac.example.com/api
QUOTA_DAILY_READ_LIMIT=50000
QUOTA_DAILY_WRITE_LIMIT=20000
QUOTA_DAILY_DELETE_LIMIT=20000
QUOTA_MONTHLY_INVOCATION_LIMIT=2000000
QUOTA_MONTHLY_EGRESS_GB_LIMIT=5

# ---------------------------------------------------------------------------
# Read cache (server/lib/db-layer.js). 0 disables it.
# ---------------------------------------------------------------------------
READ_CACHE_TTL_MS=20000

# ---------------------------------------------------------------------------
# MacBook / long-running server options
# ---------------------------------------------------------------------------
SERVE_STATIC=0               # 1 = also serve this repo's website from the same port
HOST=0.0.0.0
ENV_FILE=.env                # dotenv file to load
ENABLE_CRON=1                # 0 = disable the in-process scheduled jobs
CRON_SCHEDULE=0 0 * * *     # midnight IST cleanup + notice shift
CRON_TIMEZONE=Asia/Kolkata
ALLOW_LOCAL_BACKEND=0        # 1 = permit DATA_BACKEND=local in production

# Firebase admin authorization: only trusted custom admin claims or these UIDs
# grant global admin privileges. Sign-in by itself NEVER grants admin access.
# Look up UIDs in Firebase Console > Authentication > Users (not passwords).
ADMIN_UIDS=

# Restricted public tunnel preview (prefer npm run start:tunnel-preview).
# Blocks sensitive reads, login, registration, searches and all writes.
TUNNEL_PREVIEW=0
