# Copy to .env on the backend host. Never commit the real .env.

# Required: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

FIREBASE_PROJECT_ID=finder-owl

# Use ONE of these credential options:
# 1) Path to the Admin SDK service account JSON
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
# 2) Or the JSON itself as a single-line string (used instead of the path when set)
# SERVICE_ACCOUNT_JSON=

# App Check rollout: off | monitor | enforce
# Start at "monitor" to log failures without breaking clients, then switch to "enforce".
APP_CHECK_MODE=monitor

# Extra allowed CORS origins, comma-separated (exact scheme+host matches only)
ALLOWED_ORIGINS=

# Number of reverse-proxy hops in front of this app (1 behind nginx/ngrok)
TRUST_PROXY_HOPS=1

PORT=3000
