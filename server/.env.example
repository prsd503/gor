# Optional custom local environment. Copy to server/.env, then run:
#   ENV_FILE=server/.env npm run start:local
# For Cloud Functions use .env.firebase.example instead. Never commit real env files.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- MacBook testing mode: no Firebase at all -------------------------------
NODE_ENV=development
DATA_BACKEND=local
AUTH_MODE=local
LOCAL_ADMIN_EMAIL=admin@local.test
LOCAL_ADMIN_PASSWORD=change-me-to-a-long-random-password
APP_CHECK_MODE=off
QUOTA_ACTION=off
SERVE_STATIC=1
PORT=3000

# --- Firebase mode (Cloud Functions) ----------------------------------------
# DATA_BACKEND=firestore
# AUTH_MODE=firebase
# APP_CHECK_MODE=enforce
# QUOTA_ACTION=stop
# QUOTA_THRESHOLD=0.8
# QUOTA_FALLBACK_URLS=https://owl-mac.example.com/api
# FIREBASE_PROJECT_ID=finder-owl
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json
