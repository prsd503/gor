# PRODUCTION CLOUD FUNCTIONS CONFIGURATION
# Copy to server/.env, replace placeholders, then deploy. Do not commit .env.
# Generate a JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=production
OWL_FIREBASE_PROJECT_ID=finder-owl
DATA_BACKEND=firestore
AUTH_MODE=firebase
APP_CHECK_MODE=monitor
# Use enforce once every deployed client supplies a valid App Check token.
SERVE_STATIC=0
ENABLE_CRON=0
QUOTA_ACTION=stop
QUOTA_SOURCE=monitoring
QUOTA_THRESHOLD=0.8
QUOTA_REFRESH_MS=60000
QUOTA_FALLBACK_URLS=
# Set to the MacBook HTTPS tunnel base ending in /api.
ALLOWED_ORIGINS=https://finder-owl.web.app,https://finder-owl.firebaseapp.com
# Add your actual custom website origins, comma-separated.
FUNCTIONS_REGION=us-central1
MAX_INSTANCES=2
CONCURRENCY=20
READ_CACHE_TTL_MS=20000
# No service-account JSON here. Cloud Functions uses its runtime identity (ADC).
