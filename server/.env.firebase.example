# INITIAL READ-ONLY CLOUD FUNCTIONS CONFIGURATION
# See docs/firebase-api-setup.md; private routes and all writes are blocked.
# Copy to server/.env, replace placeholders, then deploy. Do not commit .env.
# Generate a JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=production
OWL_FIREBASE_PROJECT_ID=finder-owl
DATA_BACKEND=firestore
AUTH_MODE=firebase
APP_CHECK_MODE=monitor
# Use enforce once every deployed client supplies a valid App Check token.
SERVE_STATIC=0
ENABLE_CRON=0
QUOTA_ACTION=stop
QUOTA_SOURCE=monitoring
QUOTA_THRESHOLD=0.8
QUOTA_REFRESH_MS=60000
QUOTA_FALLBACK_URLS=
# Exact browser/WebView origins only. No paths, wildcards or ngrok trust.
# Confirm the actual Android WebView origin before changing this list.
ALLOWED_ORIGINS=https://prsd503.github.io,https://app.owlwatcher.tech,https://api.owlwatcher.tech,https://localhost,http://localhost,capacitor://localhost
# Dedicated read-only runtime account: create it before deployment.
# Grant roles/datastore.viewer and roles/monitoring.viewer, not Editor/Owner.
API_RUNTIME_SERVICE_ACCOUNT=owl-api-readonly@finder-owl.iam.gserviceaccount.com
FUNCTIONS_REGION=us-central1
MAX_INSTANCES=2
CONCURRENCY=20
READ_CACHE_TTL_MS=20000
# No service-account JSON here. Cloud Functions uses its runtime identity (ADC).

# Explicit global admin UIDs, comma-separated; no default admin-on-sign-in.
ADMIN_UIDS=
