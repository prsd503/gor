# Full-feature Firebase HTTP API release configuration.
# This enables authenticated API routes, including admin/guard and gift-code
# endpoints; it does not by itself grant IAM permissions or authorize deployment.
# Copy to server/.env privately. Never commit the filled file or an Admin SDK key.
# Generate JWT_SECRET privately: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
API_RELEASE_PROFILE=full
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NODE_ENV=production
OWL_FIREBASE_PROJECT_ID=finder-owl
DATA_BACKEND=firestore
AUTH_MODE=firebase
APP_CHECK_MODE=monitor
# Use enforce only after every supported client supplies a valid App Check token.
SERVE_STATIC=0
# HTTP Functions do not run persistent process maintenance; scheduled jobs are separate.
ENABLE_CRON=0
QUOTA_ACTION=stop
QUOTA_SOURCE=monitoring
QUOTA_THRESHOLD=0.8
QUOTA_REFRESH_MS=60000
QUOTA_FALLBACK_URLS=
# Exact browser/WebView origins only. No paths, wildcards or ngrok trust.
# Confirm the actual Android WebView origin before deployment.
ALLOWED_ORIGINS=https://prsd503.github.io,https://app.owlwatcher.tech,https://api.owlwatcher.tech,https://localhost,http://localhost,capacitor://localhost
# Create a dedicated runtime account and separately review its minimum Firestore
# read/write and Monitoring permissions. The preflight checks the name only;
# it cannot verify the account's IAM bindings.
API_RUNTIME_SERVICE_ACCOUNT=owl-api-runtime@finder-owl.iam.gserviceaccount.com
FUNCTIONS_REGION=us-central1
MAX_INSTANCES=2
CONCURRENCY=20
READ_CACHE_TTL_MS=20000
# No service-account JSON here. Cloud Functions uses its runtime identity (ADC).

# Staff roles come from verified Firebase identities and active Firestore
# admins/guards membership records; client role claims are never authorization.
