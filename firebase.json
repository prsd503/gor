{
  "functions": [
    {
      "source": "server",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci --omit=dev --no-audit --no-fund"
      ],
      "ignore": [
        "node_modules",
        ".env",
        ".env.*",
        "*.log",
        ".local-data",
        "**/*serviceAccount*.json",
        "**/*service-account*.json",
        "**/*.pem",
        "**/*.key",
        "**/application_default_credentials.json",
        "**/.*",
        "**/*service_account*.json"
      ]
    }
  ]
}
